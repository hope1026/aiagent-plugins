#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SKILL="$ROOT/skills/using-forge/SKILL.md"
[[ -f "$SKILL" ]] || exit 0
wrapped="<FORGE_BOOTSTRAP>
Forge is available for project work. Use the forge using-forge skill when its
project guidance helps the request; load specialist skills only as needed.
Preserve user intent and approved contracts, finish authorized work, and verify
the requested result with appropriate evidence. Reuse concrete authorization
and applicable evidence. Questions, plans, tests, and records serve the outcome;
they are not mandatory ceremonies for every conversation.
</FORGE_BOOTSTRAP>"
if command -v jq >/dev/null 2>&1; then
  jq -n --arg ctx "$wrapped" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$ctx}}'
else
  python3 - "$wrapped" <<'PY'
import json, sys
print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": sys.argv[1]}}))
PY
fi
